      "script": "#!/bin/bash\n# Yoki installation script (Pterodactyl)\nset -e\n\napt update\napt install -y curl tar jq ca-certificates\n\nmkdir -p /mnt/server\ncd /mnt/server\n\nREPO=\"AxenoDev/Yoki\"\nASSET_REGEX=\"x86_64-unknown-linux-musl.tar.gz$\"\n\nif [ -z \"${VERSION}\" ] || [ \"${VERSION}\" = \"latest\" ]; then\n    API_URL=\"https://api.github.com/repos/${REPO}/releases/latest\"\nelse\n    API_URL=\"https://api.github.com/repos/${REPO}/releases/tags/${VERSION}\"\nfi\n\necho \"Resolving download from ${API_URL}\"\nDOWNLOAD_URL=$(curl -sSL \"${API_URL}\" | jq -r \".assets[] | select(.name | test(\\\"${ASSET_REGEX}\\\")) | .browser_download_url\")\n\nif [ -z \"${DOWNLOAD_URL}\" ] || [ \"${DOWNLOAD_URL}\" = \"null\" ]; then\n    echo \"!! Could not find a linux-musl release asset. Aborting.\"\n    exit 1\nfi\n\necho \"Downloading ${DOWNLOAD_URL}\"\ncurl -sSL -o yoki.tar.gz \"${DOWNLOAD_URL}\"\ntar -xzf yoki.tar.gz\nrm -f yoki.tar.gz\nchmod +x yoki\n\n# Boot wrapper: regenerates server.toml with the panel-allocated port on each\n# start, and seeds motd.toml only once so player edits survive restarts.\ncat > start.sh <<'SH'\n#!/bin/bash\nmkdir -p config\n\nexec ./yoki\nSH\nchmod +x start.sh\n\necho \"-----------------------------------------\"\necho \"Yoki installation completed successfully.\"\necho \"-----------------------------------------\"\n",
